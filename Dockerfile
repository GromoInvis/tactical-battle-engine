# Базовий шар (Base Image): беремо офіційний легкий дистрибутив Python версії 3.11 на базі Debian Slim.
# "slim" важить значно менше (близько 120 МБ) за повний образ Python (понад 900 МБ).
FROM python:3.11-slim

# Робоча директорія всередині контейнера: всі наступні команди (COPY, RUN, CMD)
# будуть автоматично виконуватися всередині цієї створеної папки /app.
WORKDIR /app

# Оптимізація кешування шарів (Layer Caching):
# Спершу копіюємо ТІЛЬКИ файл залежностей requirements.txt.
# Якщо сам код програми зміниться, але список бібліотек ні — Docker візьме встановлені пакети
# з готового кешу і не завантажуватиме їх заново через інтернет.
COPY requirements.txt .

# RUN: виконує команди під час збірки (build time).
# --no-cache-dir: не зберігає завантажені архіви pip у тимчасових папках,
# що додатково зменшує розмір фінального контейнера на десятки мегабайтів.
RUN pip install --no-cache-dir -r requirements.txt

# Копіюємо решту файлів проєкту в контейнер.
# Перша крапка (.) — поточна папка на твоєму комп'ютері.
# Друга крапка (.) — поточна папка всередині контейнера (/app).
COPY . .

# CMD (Command): команда за замовчуванням, яка виконується при запуску контейнера (run time).
# Запускаємо сервер uvicorn, що піднімає додаток app з файлу main.py.
# --host 0.0.0.0: слухати ВСІ доступні мережеві інтерфейси (без цього контейнер не відповість ззовні).
# --port 8000: внутрішній порт сервера.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]