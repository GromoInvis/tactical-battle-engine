# ==============================================================================
# ТЕРАФОРМ-КОНФІГУРАЦІЯ ДЛЯ BATTLE ENGINE
# ==============================================================================

# Блок terraform: вказує версії та необхідні плагіни (провайдери)
terraform {
  required_providers {
    # docker-провайдер дозволяє Terraform керувати локальними контейнерами, образами та мережами
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0.2"
    }
  }
}

# Блок provider: налаштування підключення до цільової платформи (у нашому випадку — локальний Docker)
provider "docker" {
  # Для Windows Terraform автоматично знайде сокет Docker Desktop (npipe:////./pipe/docker_engine)
}

# ------------------------------------------------------------------------------
# РЕСУРС 1: Віртуальна мережа для нашої бойової інфраструктури
# ------------------------------------------------------------------------------
resource "docker_network" "battle_network" {
  name = "battle_infra_network"
}

# ------------------------------------------------------------------------------
# РЕСУРС 2: Завантаження образу Nginx
# ------------------------------------------------------------------------------
resource "docker_image" "nginx" {
  name         = "nginx:alpine"
  keep_locally = true # Не видаляти образ з диску комп'ютера при знищенні інфраструктури
}

# ------------------------------------------------------------------------------
# РЕСУРС 3: Запуск контейнера Nginx через Terraform
# ------------------------------------------------------------------------------
resource "docker_container" "battle_gateway" {
  name  = "battle-gateway-tf"
  image = docker_image.nginx.image_id

  # Підключаємо створений контейнер до нашої мережі
  networks_advanced {
    name = docker_network.battle_network.name
  }

  # Прокидаємо порт 8080 комп'ютера на 80 порт контейнера
  ports {
    internal = 80
    external = 8085  # Змінили з 8080 на 8085
  }
}

# ------------------------------------------------------------------------------
# ВИВІД (Outputs): корисні дані, які Terraform покаже після створення інфраструктури
# ------------------------------------------------------------------------------
output "gateway_url" {
  description = "Посилання для перевірки шлюзу Nginx"
  value       = "http://localhost:8085"
}