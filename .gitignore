# ==============================================================================
# GITIGNORE: Файли та папки, які Git має повністю ігнорувати
# ==============================================================================

# Службові кеші Python та Pytest
__pycache__/
*.py[cod]
.pytest_cache/

# Службова папка провайдерів Terraform (важить сотні мегабайт, скачується через 'terraform init')
.terraform/
.terraform.lock.hcl

# КРИТИЧНО ДЛЯ БЕЗПЕКИ: файли стану інфраструктури Terraform
# Вони можуть містити приватні токени, паролі або внутрішні ID інфраструктури
*.tfstate
*.tfstate.*
*.tfstate.backup

# Локальні змінні та кредовники
.env
*.env